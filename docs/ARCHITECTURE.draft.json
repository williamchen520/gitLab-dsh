{
  "name": "exprec",
  "display_name": "实验记录系统",
  "version": "0.1.0-draft",
  "status": "draft",
  "_note": "草案。经人类回复「批准修改」后，才可改名为 ARCHITECTURE.json 正式生效。",

  "decisions": {
    "D-1": {
      "choice": "B",
      "summary": "派生子实验：分叉落在领域模型上，experiment.derived_from_snapshot_id 指向基线快照",
      "rationale": "对照组/实验组是不同实验，共享 experiment 行会导致元数据降级；且 B->A 不可逆，A->B 可逆"
    },
    "D-2": {
      "choice": "A",
      "summary": "全量内容寻址 + 硬链接去重，阈值配置项默认关闭",
      "rationale": "引用策略是唯一会在不可变承诺上开口子的地方，且失效是静默的"
    },
    "D-6": {
      "choice": "A",
      "summary": "整实验快照：一次提交固化该实验下所有 run/step/artifact 的当前状态",
      "rationale": "内容寻址让未变文件零成本复用，整实验快照并不重；单对象快照会导致 DAG 线性爆炸"
    }
  },

  "storage": {
    "metadata": "sqlite3",
    "objects": "cas",
    "cas_layout": "blobs/<sha256:2>/<sha256:62>",
    "hash": "sha256",
    "dedup": "hardlink",
    "large_file_threshold_bytes": null,
    "large_file_note": "null 表示不启用引用模式，所有文件一律寻址"
  },

  "layers": {
    "core": "纯 Python，禁止 import flask",
    "api": "Flask 蓝图，本地端口",
    "shells": ["web", "desktop", "dsh-plugin"]
  },

  "api": {
    "prefix": "/api",
    "endpoints": [
      {
        "rule": "/api/health",
        "endpoint": "system.health",
        "methods": ["GET"],
        "status": "planned"
      },

      {
        "rule": "/api/projects",
        "endpoint": "projects.list",
        "methods": ["GET"],
        "status": "planned",
        "parameters": ["page", "size"]
      },
      {
        "rule": "/api/projects",
        "endpoint": "projects.create",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "projects_create",
          "blueprint": "projects",
          "function": "create_project",
          "mcp_server": "exprec_server",
          "mcp_tool": "create_project",
          "description": "Create a project. Body: {name, description}.",
          "parameters": []
        }
      },
      {
        "rule": "/api/projects/<int:project_id>",
        "endpoint": "projects.get",
        "methods": ["GET"],
        "status": "planned"
      },

      {
        "rule": "/api/experiments",
        "endpoint": "experiments.list",
        "methods": ["GET"],
        "status": "planned",
        "parameters": ["project_id", "page", "size"]
      },
      {
        "rule": "/api/experiments",
        "endpoint": "experiments.create",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "experiments_create",
          "blueprint": "experiments",
          "function": "create_experiment",
          "mcp_server": "exprec_server",
          "mcp_tool": "create_experiment",
          "description": "Create an experiment. Body: {project_id, title, hypothesis, params}.",
          "parameters": []
        }
      },
      {
        "rule": "/api/experiments/<int:experiment_id>",
        "endpoint": "experiments.get",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/experiments/<int:experiment_id>",
        "endpoint": "experiments.update",
        "methods": ["PATCH"],
        "status": "planned",
        "codegen": {
          "id": "experiments_update",
          "blueprint": "experiments",
          "function": "update_experiment",
          "mcp_server": "exprec_server",
          "mcp_tool": "update_experiment",
          "description": "Update mutable fields. Body: {title?, hypothesis?, params?, status?}.",
          "parameters": []
        }
      },
      {
        "rule": "/api/experiments/<int:experiment_id>/derive",
        "endpoint": "experiments.derive",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "experiments_derive",
          "blueprint": "experiments",
          "function": "derive_experiment",
          "mcp_server": "exprec_server",
          "mcp_tool": "derive_experiment",
          "description": "Fork a new experiment from a snapshot (D-1=B). Body: {snapshot_id, title}. Zero-copy: shares CAS objects.",
          "parameters": []
        }
      },
      {
        "rule": "/api/experiments/<int:experiment_id>/export",
        "endpoint": "experiments.export",
        "methods": ["GET"],
        "status": "planned",
        "parameters": ["snapshot_id", "format"]
      },

      {
        "rule": "/api/experiments/<int:experiment_id>/runs",
        "endpoint": "runs.list",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/experiments/<int:experiment_id>/runs",
        "endpoint": "runs.create",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "runs_create",
          "blueprint": "runs",
          "function": "create_run",
          "mcp_server": "exprec_server",
          "mcp_tool": "create_run",
          "description": "Start a run under an experiment. Body: {params}.",
          "parameters": []
        }
      },
      {
        "rule": "/api/runs/<int:run_id>",
        "endpoint": "runs.get",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/runs/<int:run_id>/steps",
        "endpoint": "steps.list",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/runs/<int:run_id>/steps",
        "endpoint": "steps.create",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "steps_create",
          "blueprint": "steps",
          "function": "create_step",
          "mcp_server": "exprec_server",
          "mcp_tool": "create_step",
          "description": "Append a step. Body: {action, observation, duration_s}.",
          "parameters": []
        }
      },

      {
        "rule": "/api/runs/<int:run_id>/artifacts",
        "endpoint": "artifacts.upload",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "artifacts_upload",
          "blueprint": "artifacts",
          "function": "upload_artifact",
          "mcp_server": "exprec_server",
          "mcp_tool": "upload_artifact",
          "description": "Upload a file into the CAS and attach it. Body: multipart {file, path}.",
          "parameters": []
        }
      },
      {
        "rule": "/api/artifacts/<int:artifact_id>/content",
        "endpoint": "artifacts.content",
        "methods": ["GET"],
        "status": "planned"
      },

      {
        "rule": "/api/experiments/<int:experiment_id>/snapshots",
        "endpoint": "snapshots.create",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "snapshots_create",
          "blueprint": "snapshots",
          "function": "create_snapshot",
          "mcp_server": "exprec_server",
          "mcp_tool": "create_snapshot",
          "description": "Freeze the whole experiment into an immutable snapshot. Body: {message, author}.",
          "parameters": []
        }
      },
      {
        "rule": "/api/experiments/<int:experiment_id>/snapshots",
        "endpoint": "snapshots.list",
        "methods": ["GET"],
        "status": "planned",
        "parameters": ["page", "size"]
      },
      {
        "rule": "/api/snapshots/<int:snapshot_id>",
        "endpoint": "snapshots.get",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/snapshots/<int:snapshot_id>/tree",
        "endpoint": "snapshots.tree",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/snapshots/<int:left_id>/diff/<int:right_id>",
        "endpoint": "snapshots.diff",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/snapshots/<int:snapshot_id>/verify",
        "endpoint": "snapshots.verify",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/snapshots/<int:snapshot_id>/tags",
        "endpoint": "tags.list",
        "methods": ["GET"],
        "status": "planned"
      },
      {
        "rule": "/api/snapshots/<int:snapshot_id>/tags",
        "endpoint": "tags.create",
        "methods": ["POST"],
        "status": "planned",
        "codegen": {
          "id": "tags_create",
          "blueprint": "tags",
          "function": "create_tag",
          "mcp_server": "exprec_server",
          "mcp_tool": "create_tag",
          "description": "Pin a milestone name to a snapshot. Body: {name}.",
          "parameters": []
        }
      }
    ]
  }
}
